{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LingyuCoder/tree-shaking-compat/schema/case.schema.json",
  "title": "Tree-shaking conformance case",
  "type": "object",
  "required": ["id", "title", "category", "entry", "module", "files", "expect", "provenance"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "entry": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "module": { "enum": ["esm", "commonjs"] },
    "files": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "minProperties": 1
    },
    "expect": {
      "type": "object",
      "required": ["value", "absent"],
      "properties": {
        "value": true,
        "absent": { "type": "array", "items": { "type": "string" } },
        "present": { "type": "array", "items": { "type": "string" } }
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["module-export", "side-effect", "stdout", "test-harness"] },
        "runtime": { "type": "boolean" },
        "stdout": { "type": "string" }
      }
    },
    "oracle": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" },
        "absent": { "type": "array", "items": { "type": "string" } },
        "present": { "type": "array", "items": { "type": "string" } },
        "stringMarkers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "unsupportedBundlers": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "portabilityIssues": {
      "type": "array",
      "items": { "type": "string" }
    },
    "buildOptions": {
      "type": "object",
      "properties": {
        "ignoreAnnotations": { "type": "boolean" },
        "external": { "type": "array", "items": { "type": "string" } },
        "loader": { "type": "object", "additionalProperties": { "type": "string" } },
        "jsx": true
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["bundler", "url"],
        "properties": {
          "bundler": { "type": "string" },
          "suite": { "type": "string" },
          "caseId": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "upstreamStatus": { "type": "string" }
        }
      }
    }
  }
}
