{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LingyuCoder/tree-shaking-compat/schema/case.schema.json",
  "title": "Tree-shaking conformance case",
  "type": "object",
  "required": ["id", "title", "category", "entry", "module", "files", "expect", "provenance"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "entry": { "type": "string", "minLength": 1 },
    "module": { "enum": ["esm", "commonjs"] },
    "files": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "minProperties": 1
    },
    "expect": {
      "type": "object",
      "required": ["value", "absent"],
      "properties": {
        "value": true,
        "absent": { "type": "array", "items": { "type": "string" } },
        "present": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["bundler", "url"],
        "properties": {
          "bundler": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
